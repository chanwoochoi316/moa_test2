# Supabase Dashboard > Project Settings > API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Server only: Supabase Secret key; do not use NEXT_PUBLIC_ prefix
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET
# Optional: if not set AI features show a transparent fallback
ANTHROPIC_API_KEY=
# Optional: model name must be a currently supported Anthropic model ID
ANTHROPIC_MODEL=
# Server-side AI usage cap PER INSTANCE/day (best-effort demo guard, not a spending guarantee)
AI_ENABLED=false
